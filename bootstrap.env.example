# Copie para bootstrap.env e substitua todos os valores antes da primeira execução.
# Esse usuário é criado apenas quando ainda não houver um Admin no banco.
INITIAL_ADMIN_NAME=Nome do administrador
INITIAL_ADMIN_EMAIL=admin@exemplo.com
INITIAL_ADMIN_CPF=00000000000
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Segundo administrador (opcional).
INITIAL_ADMIN_2_NAME=Segundo administrador
INITIAL_ADMIN_2_EMAIL=admin2@exemplo.com
INITIAL_ADMIN_2_CPF=00000000001
INITIAL_ADMIN_2_PASSWORD=troque-por-outra-senha-forte
