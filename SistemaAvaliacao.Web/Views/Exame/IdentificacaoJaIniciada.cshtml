@model IdentificacaoViewModel
@{
    ViewData["Title"] = "Prova Já Iniciada";
    Layout = "~/Views/Shared/_LayoutExame.cshtml";
}

@* O e-mail vem do formulário do usuário: vai em Destaque.Texto, que é sempre codificado em HTML. *@
@await Html.PartialAsync("_PaginaEstado", new PaginaEstadoViewModel
{
    Variante = "info",
    Icone = "fa-info-circle",
    Titulo = Model.NomeProva,
    Subtitulo = "Você já iniciou esta prova.",
    Destaque = new DestaqueEstado
    {
        Variante = "info",
        Rotulo = "E-mail:",
        Texto = Model.Email ?? string.Empty
    },
    DetalheHtml = "A prova é de <strong>uma única tentativa</strong>. Se você saiu da tela, a tentativa foi encerrada. Contate o administrador se precisar de ajuda.",
    BotaoTexto = "Voltar",
    BotaoUrl = "/"
})
