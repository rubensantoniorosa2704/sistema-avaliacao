@model IdentificacaoViewModel
@{
    ViewData["Title"] = "Prova Indisponível";
    Layout = "~/Views/Shared/_LayoutExame.cshtml";
    var éFuturo = Model.Status == "AgendadaPara";
    var formato = "dd/MM/yyyy \\à\\s HH:mm";
}

@await Html.PartialAsync("_PaginaEstado", new PaginaEstadoViewModel
{
    Variante = "warning",
    Icone = éFuturo ? "fa-calendar" : "fa-clock",
    Titulo = Model.NomeProva,
    Subtitulo = éFuturo
        ? "Esta prova ainda não está disponível."
        : "O prazo para responder esta prova expirou.",
    Destaque = éFuturo
        ? new DestaqueEstado
        {
            Variante = "info",
            Rotulo = "Disponível a partir de:",
            Texto = Model.DataInicio.ParaFusoLocal().ToString(formato)
        }
        : new DestaqueEstado
        {
            Variante = "warning",
            Rotulo = "Encerrada em:",
            Texto = Model.DataFim.ParaFusoLocal().ToString(formato)
        },
    BotaoTexto = "Voltar",
    BotaoUrl = "/"
})
