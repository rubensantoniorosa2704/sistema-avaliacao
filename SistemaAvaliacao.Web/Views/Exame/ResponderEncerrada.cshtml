@model ResponderProvaViewModel
@{
    ViewData["Title"] = "Prova Encerrada";
    Layout = "~/Views/Shared/_LayoutExame.cshtml";
}

@await Html.PartialAsync("_PaginaEstado", new PaginaEstadoViewModel
{
    Variante = "secondary",
    Icone = "fa-clock",
    Titulo = Model.NomeProva,
    Subtitulo = "O prazo para responder esta prova expirou.",
    Destaque = new DestaqueEstado
    {
        Variante = "secondary",
        Rotulo = "Prova encerrada em:",
        Texto = Model.DataFim.ParaFusoLocal().ToString("dd/MM/yyyy \\à\\s HH:mm")
    },
    BotaoTexto = "Voltar",
    BotaoUrl = "/"
})
