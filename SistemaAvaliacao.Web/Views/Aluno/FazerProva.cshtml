@model SistemaAvaliacao.Web.Models.ViewModels.FazerProvaViewModel
@{
    ViewData["Title"] = Model.NomeProva;
}

@* Barra fixa com cronômetro e progresso — sempre visível no mobile *@
<div class="sticky-top bg-white border-bottom shadow-sm">
    <div class="container py-2" style="max-width: 720px;">
        <div class="d-flex justify-content-between align-items-center gap-2">
            <div class="text-truncate">
                <div class="fw-semibold text-truncate">@Model.NomeProva</div>
                <small class="text-muted">
                    Respondidas: <span id="respondidas">@Model.TotalRespondidas</span>/@Model.TotalQuestoes
                </small>
            </div>
            <span id="timerBadge" class="badge bg-dark fs-6 flex-shrink-0">
                <i class="fas fa-clock me-1"></i><span id="timer">--:--</span>
            </span>
        </div>
    </div>
</div>

<div class="container py-3" style="max-width: 720px;">

    @if (!string.IsNullOrEmpty(Model.Descricao))
    {
        <p class="text-muted small mb-3">@Model.Descricao</p>
    }

    <div class="d-flex flex-column gap-3">
        @foreach (var q in Model.Questoes)
        {
            <div class="card shadow-sm @(q.RespostaMarcada.HasValue ? "border-success" : "")" id="card_@q.QuestaoId">
                <div class="card-body">
                    <div class="d-flex gap-2 mb-3">
                        <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                              style="width:32px;height:32px;">@q.Ordem</span>
                        <div class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(q.Enunciado))
                            {
                                <p class="text-muted small mb-2">@q.Enunciado</p>
                            }
                            @if (!string.IsNullOrEmpty(q.ImagemUrl))
                            {
                                <img src="@q.ImagemUrl" alt="@q.DescricaoAcessibilidade"
                                     class="img-fluid rounded mb-2" />
                            }
                            <p class="fw-medium mb-0">@q.Comando</p>
                        </div>
                    </div>

                    <fieldset>
                        <legend class="visually-hidden">Alternativas da questão @q.Ordem</legend>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var alt in q.Alternativas)
                            {
                                var inputId = $"q_{q.QuestaoId}_{alt.Letra}";
                                <div class="form-check border rounded p-2 ps-4 m-0">
                                    <input class="form-check-input" type="radio"
                                           name="q_@q.QuestaoId" id="@inputId" value="@alt.Letra"
                                           data-questao="@q.QuestaoId"
                                           @(q.RespostaMarcada == alt.Letra ? "checked" : "") />
                                    <label class="form-check-label d-block" for="@inputId">
                                        <strong>@alt.Letra)</strong> @alt.Texto
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>
                </div>
            </div>
        }
    </div>

    <div class="d-grid mt-4 mb-2">
        <button type="button" id="btnFinalizar" class="btn btn-success btn-lg">
            <i class="fas fa-paper-plane me-1"></i>Finalizar prova
        </button>
    </div>
    <p class="text-center text-muted small">
        Suas respostas são salvas automaticamente ao marcá-las.
    </p>

    <form id="formFinalizar" asp-action="FinalizarProva" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="provaId" value="@Model.ProvaId" />
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var provaId = '@Model.ProvaId';
            var salvarUrl = '@Url.Action("SalvarResposta")';
            var totalQuestoes = @Model.TotalQuestoes;
            var segundos = @Model.SegundosRestantes;
            var token = document.querySelector('#formFinalizar input[name="__RequestVerificationToken"]').value;

            var timerEl = document.getElementById('timer');
            var timerBadge = document.getElementById('timerBadge');
            var respondidasEl = document.getElementById('respondidas');
            var formFinalizar = document.getElementById('formFinalizar');
            var btnFinalizar = document.getElementById('btnFinalizar');
            var expirou = false;

            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            function formatar(s) {
                if (s < 0) s = 0;
                var h = Math.floor(s / 3600);
                var m = Math.floor((s % 3600) / 60);
                var sec = s % 60;
                return (h > 0 ? pad(h) + ':' : '') + pad(m) + ':' + pad(sec);
            }

            function enviarFinalizacao() {
                if (expirou) return;
                expirou = true;
                btnFinalizar.disabled = true;
                formFinalizar.submit();
            }

            // Cronômetro apenas visual — o servidor é a fonte da verdade.
            function tick() {
                timerEl.textContent = formatar(segundos);
                if (segundos <= 60) {
                    timerBadge.classList.remove('bg-dark');
                    timerBadge.classList.add('bg-danger');
                }
                if (segundos <= 0) {
                    if (typeof toastr !== 'undefined') {
                        toastr.warning('O tempo terminou. Enviando suas respostas...');
                    }
                    enviarFinalizacao();
                    return;
                }
                segundos--;
                setTimeout(tick, 1000);
            }
            tick();

            // Auto-save de cada resposta
            document.querySelectorAll('input[type=radio][data-questao]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    var questaoId = this.getAttribute('data-questao');
                    var card = document.getElementById('card_' + questaoId);

                    $.ajax({
                        url: salvarUrl,
                        method: 'POST',
                        data: {
                            provaId: provaId,
                            questaoId: questaoId,
                            alternativaMarcada: this.value,
                            __RequestVerificationToken: token
                        }
                    }).done(function (res) {
                        if (res.sucesso) {
                            if (card) card.classList.add('border-success');
                            if (typeof res.totalRespondidas !== 'undefined') {
                                respondidasEl.textContent = res.totalRespondidas;
                            }
                            if (typeof res.segundosRestantes !== 'undefined') {
                                segundos = res.segundosRestantes; // re-sincroniza com o servidor
                            }
                        } else if (res.expirado) {
                            toastr.warning(res.mensagem || 'O tempo da prova terminou.');
                            window.location = res.redirectUrl;
                        } else {
                            toastr.error(res.mensagem || 'Não foi possível salvar a resposta.');
                        }
                    }).fail(function () {
                        toastr.error('Falha de conexão ao salvar. Verifique sua internet.');
                    });
                });
            });

            // Finalizar com confirmação
            btnFinalizar.addEventListener('click', function () {
                var respondidas = parseInt(respondidasEl.textContent, 10) || 0;
                var faltam = totalQuestoes - respondidas;
                var msg = faltam > 0
                    ? 'Você deixou ' + faltam + ' questão(ões) sem responder. Finalizar mesmo assim?'
                    : 'Deseja finalizar e enviar suas respostas?';
                if (confirm(msg)) {
                    enviarFinalizacao();
                }
            });
        })();
    </script>
}
