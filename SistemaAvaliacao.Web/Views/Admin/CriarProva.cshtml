@model SistemaAvaliacao.Web.Models.ViewModels.CriarProvaViewModel
@{
    ViewData["Title"] = "Nova Prova";
}

<div class="container py-4" style="max-width:720px">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Provas">Provas</a></li>
            <li class="breadcrumb-item active">Nova Prova</li>
        </ol>
    </nav>

    <h4 class="fw-bold mb-4">Nova Prova</h4>

    <form asp-action="CriarProva" method="post">

        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title text-muted mb-3"><i class="fas fa-info-circle me-1"></i>Informações Básicas</h6>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">Nome da Prova <span class="text-danger">*</span></label>
                    <input asp-for="Nome" class="form-control" placeholder="Ex: Simulado ENADE 2027" autofocus />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="mb-0">
                    <label asp-for="Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control" rows="2" placeholder="Opcional — breve descrição da prova"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="mt-3">
                    <label asp-for="Instituicao" class="form-label">Instituição</label>
                    <input asp-for="Instituicao" class="form-control" placeholder="Opcional — instituição à qual a prova se destina" />
                    <div class="form-text">Uso interno (organização e busca). Não aparece para o aluno.</div>
                    <span asp-validation-for="Instituicao" class="text-danger small"></span>
                </div>

                <div class="mt-3">
                    <label asp-for="NumeroAlternativas" class="form-label">Alternativas por questão</label>
                    <select asp-for="NumeroAlternativas" class="form-select">
                        <option value="4">4 alternativas (A-D)</option>
                        <option value="5">5 alternativas (A-E)</option>
                    </select>
                    <div class="form-text">A folha impressa usará esta quantidade em todas as 50 questões.</div>
                    <span asp-validation-for="NumeroAlternativas" class="text-danger small"></span>
                </div>

                <div class="mt-3">
                    <label asp-for="TipoAplicacao" class="form-label">Tipo de Aplicação <span class="text-danger">*</span></label>
                    <select asp-for="TipoAplicacao" class="form-select">
                        <option value="2">Virtual (resposta online)</option>
                        <option value="1">Física (folhas escaneadas)</option>
                    </select>
                    <div class="form-text">
                        <strong>Virtual:</strong> alunos respondem diretamente no sistema.<br/>
                        <strong>Física:</strong> gera folhas de respostas para imprimir, depois digitaliza para correção automática.
                    </div>
                    <span asp-validation-for="TipoAplicacao" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h6 class="card-title text-muted mb-3"><i class="fas fa-clock me-1"></i>Janela de Aplicação</h6>
                <p class="text-muted small mb-3">O aluno só consegue responder entre o início e o fim.</p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DataInicio" class="form-label">Início <span class="text-danger">*</span></label>
                        <input asp-for="DataInicio" class="form-control" type="datetime-local" />
                        <span asp-validation-for="DataInicio" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DataFim" class="form-label">Fim <span class="text-danger">*</span></label>
                        <input asp-for="DataFim" class="form-control" type="datetime-local" />
                        <span asp-validation-for="DataFim" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check me-1"></i>Criar Prova
            </button>
            <a asp-action="Provas" class="btn btn-light">Cancelar</a>
        </div>

    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
