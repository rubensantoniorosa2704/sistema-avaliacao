@* Modal: erro de importação de alunos. Ver CONVENTIONS.md §6. *@
<div class="modal fade" id="modalErroImportacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <i class="fas fa-circle-exclamation text-danger fa-2x mb-3 d-block"></i>
                <h6>Erro na importação</h6>
                <p class="text-muted small mb-3" id="erroImportacaoMsg">Confira o arquivo e tente novamente.</p>
                <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">Entendi</button>
            </div>
        </div>
    </div>
</div>
