@model SistemaAvaliacao.Web.Models.ViewModels.ImprimirProvaViewModel
@{
    ViewData["Title"] = $"Imprimir — {Model.NomeProva}";
    Layout = null; // página standalone, sem navbar
    var letras = new[] { 'A', 'B', 'C', 'D', 'E' };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        /* ── Variáveis ── */
        :root {
            --ink: #172033;
            --muted: #64748b;
            --line: #dbe3ef;
            --accent: #2563eb;
            --accent-soft: #eff6ff;
        }

        body {
            font-family: Georgia, 'Times New Roman', serif;
            color: var(--ink);
            background: #f8f9fa;
        }

        /* ── Barra de controle (só na tela) ── */
        .print-toolbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            background: #fff;
            border-bottom: 1px solid var(--line);
            padding: .65rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
        }

        .print-page {
            background: #fff;
            width: 210mm;
            min-height: 297mm;
            margin: 80px auto 2rem;
            padding: 18mm 18mm 20mm;
            box-shadow: 0 4px 24px rgba(0,0,0,.10);
        }

        /* ── Cabeçalho da prova ── */
        .prova-cabecalho {
            border-bottom: 2px solid var(--ink);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .prova-titulo {
            font-size: 1.4rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
        }
        .prova-descricao {
            font-size: .92rem;
            color: var(--muted);
            margin-top: 4px;
        }
        .prova-instrucoes {
            font-size: .82rem;
            color: var(--muted);
            margin-top: 6px;
        }

        /* ── Questões ── */
        .questao-bloco {
            margin-bottom: 22px;
        }
        .questao-numero {
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            margin-bottom: 4px;
        }
        .texto-base-bloco {
            background: #f0f4ff;
            border-left: 3px solid var(--accent);
            padding: 10px 14px;
            margin-bottom: 12px;
            font-size: .92rem;
            white-space: pre-wrap;
        }
        .questao-enunciado {
            background: #f8f9fa;
            border: 1px solid var(--line);
            border-radius: 4px;
            padding: 8px 12px;
            font-size: .9rem;
            color: var(--muted);
            margin-bottom: 10px;
        }
        .questao-imagem {
            max-width: 100%;
            max-height: 260px;
            object-fit: contain;
            display: block;
            margin: 0 auto 10px;
        }
        .questao-comando {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 10px;
            line-height: 1.5;
        }
        .alternativas-lista {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .alternativas-lista li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 5px 8px;
            border-radius: 4px;
            font-size: .93rem;
            line-height: 1.45;
        }
        .alternativas-lista li:nth-child(odd) {
            background: #fafafa;
        }
        .alt-letra {
            font-weight: 700;
            flex-shrink: 0;
            width: 1.4em;
        }

        /* Separador entre questões */
        .questao-bloco + .questao-bloco {
            border-top: 1px dashed var(--line);
            padding-top: 18px;
        }

        /* ── Regras de impressão ── */
        @@media print {
            * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

            body { background: #fff; }

            .print-toolbar { display: none !important; }

            .print-page {
                width: 100%;
                margin: 0;
                padding: 15mm 15mm 18mm;
                box-shadow: none;
            }

            /* Evita quebra no meio de uma questão sempre que possível */
            .questao-bloco {
                break-inside: avoid;
            }

            /* Forçar quebra de página antes do texto-base (início de grupo) */
            .texto-base-bloco {
                break-before: auto;
            }
        }
    </style>
</head>
<body>

    @* ── Barra de controle (oculta na impressão) ── *@
    <div class="print-toolbar">
        <a href="@Url.Action("DetalhesProva", "Admin", new { id = Model.ProvaId })"
           class="btn btn-outline-secondary btn-sm">
            ← Voltar
        </a>
        <div class="flex-grow-1">
            <strong>@Model.NomeProva</strong>
            <span class="text-muted ms-2 small">@Model.Questoes.Count questões</span>
        </div>
        @if (Model.NumeroAlunos > 0)
        {
            <span class="text-muted small me-2">
                <i class="fas fa-info-circle me-1"></i>
                Defina <strong>@Model.NumeroAlunos</strong> @(Model.NumeroAlunos == 1 ? "cópia" : "cópias") no diálogo de impressão
            </span>
        }
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
            🖨 Imprimir
        </button>
    </div>

    @* ── Página da prova ── *@
    <div class="print-page">

        @* Cabeçalho *@
        <div class="prova-cabecalho">
            <div class="prova-titulo">@Model.NomeProva</div>
            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                <div class="prova-descricao">@Model.Descricao</div>
            }
            <div class="prova-instrucoes">
                Leia com atenção cada questão antes de marcar sua resposta na folha de respostas.
            </div>
        </div>

        @* Questões *@
        @{
            string? textoBaseAnterior = null;
        }
        @foreach (var q in Model.Questoes)
        {
            <div class="questao-bloco">
                <div class="questao-numero">Questão @q.Ordem</div>

                @* Texto-base — exibe apenas na primeira ocorrência *@
                @if (!string.IsNullOrWhiteSpace(q.TextoBase) && q.TextoBase != textoBaseAnterior)
                {
                    <div class="texto-base-bloco">📖 <strong>Texto-base</strong><br />@q.TextoBase</div>
                    textoBaseAnterior = q.TextoBase;
                }

                @* Enunciado *@
                @if (!string.IsNullOrWhiteSpace(q.Enunciado))
                {
                    <div class="questao-enunciado">@q.Enunciado</div>
                }

                @* Imagem *@
                @if (!string.IsNullOrWhiteSpace(q.ImagemUrl))
                {
                    <img src="@q.ImagemUrl"
                         alt="@(string.IsNullOrWhiteSpace(q.DescricaoAcessibilidade) ? $"Imagem da questão {q.Ordem}" : q.DescricaoAcessibilidade)"
                         class="questao-imagem" />
                }

                @* Comando *@
                <div class="questao-comando">@q.Comando</div>

                @* Alternativas *@
                <ul class="alternativas-lista">
                    @for (int i = 0; i < q.NumeroAlternativas; i++)
                    {
                        var letra = letras[i];
                        var texto = letra switch
                        {
                            'A' => q.AlternativaA,
                            'B' => q.AlternativaB,
                            'C' => q.AlternativaC,
                            'D' => q.AlternativaD,
                            'E' => q.AlternativaE,
                            _   => null
                        };
                        if (string.IsNullOrWhiteSpace(texto)) continue;

                        <li>
                            <span class="alt-letra">@letra)</span>
                            <span>@texto</span>
                        </li>
                    }
                </ul>
            </div>
        }

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Aciona o diálogo de impressão automaticamente ao abrir a página
        window.addEventListener('load', function () {
            // Pequeno delay para garantir que as imagens já carregaram
            setTimeout(function () { window.print(); }, 600);
        });
    </script>
</body>
</html>
