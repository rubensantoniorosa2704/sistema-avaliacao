@model SistemaAvaliacao.Web.Models.ViewModels.ImprimirProvaViewModel
@{
    ViewData["Title"] = $"Imprimir — {Model.NomeProva}";
    Layout = null; // página standalone, sem navbar
    var letras = new[] { 'A', 'B', 'C', 'D', 'E' };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/imprimir-prova.css" asp-append-version="true" />
</head>
<body>

    @* ── Barra de controle (oculta na impressão) ── *@
    <div class="print-toolbar">
        <a href="@Url.Action("DetalhesProva", "Admin", new { id = Model.ProvaId })"
           class="btn btn-outline-secondary btn-sm">
            ← Voltar
        </a>
        <div class="flex-grow-1">
            <strong>@Model.NomeProva</strong>
            <span class="text-muted ms-2 small">@Model.Questoes.Count questões</span>
        </div>
        @if (Model.NumeroAlunos > 0)
        {
            <span class="text-muted small me-2">
                <i class="fas fa-info-circle me-1"></i>
                Defina <strong>@Model.NumeroAlunos</strong> @(Model.NumeroAlunos == 1 ? "cópia" : "cópias") no diálogo de impressão
            </span>
        }
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">
            🖨 Imprimir
        </button>
    </div>

    @* ── Página da prova ── *@
    <div class="print-page">

        @* Cabeçalho *@
        <div class="prova-cabecalho">
            <div class="prova-titulo">@Model.NomeProva</div>
            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                <div class="prova-descricao">@Model.Descricao</div>
            }
            <div class="prova-instrucoes">
                Leia com atenção cada questão antes de marcar sua resposta na folha de respostas.
            </div>
        </div>

        @* Questões *@
        @{
            string? textoBaseAnterior = null;
        }
        @foreach (var q in Model.Questoes)
        {
            <div class="questao-bloco">
                <div class="questao-numero">Questão @q.Ordem</div>

                @* Texto-base — exibe apenas na primeira ocorrência *@
                @if (!string.IsNullOrWhiteSpace(q.TextoBase) && q.TextoBase != textoBaseAnterior)
                {
                    <div class="texto-base-bloco">📖 <strong>Texto-base</strong><br />@q.TextoBase</div>
                    textoBaseAnterior = q.TextoBase;
                }

                @* Enunciado *@
                @if (!string.IsNullOrWhiteSpace(q.Enunciado))
                {
                    <div class="questao-enunciado">@q.Enunciado</div>
                }

                @* Imagem *@
                @if (!string.IsNullOrWhiteSpace(q.ImagemUrl))
                {
                    <img src="@q.ImagemUrl"
                         alt="@(string.IsNullOrWhiteSpace(q.DescricaoAcessibilidade) ? $"Imagem da questão {q.Ordem}" : q.DescricaoAcessibilidade)"
                         class="questao-imagem" />
                }

                @* Comando *@
                <div class="questao-comando">@q.Comando</div>

                @* Alternativas *@
                <ul class="alternativas-lista">
                    @for (int i = 0; i < q.NumeroAlternativas; i++)
                    {
                        var letra = letras[i];
                        var texto = letra switch
                        {
                            'A' => q.AlternativaA,
                            'B' => q.AlternativaB,
                            'C' => q.AlternativaC,
                            'D' => q.AlternativaD,
                            'E' => q.AlternativaE,
                            _   => null
                        };
                        if (string.IsNullOrWhiteSpace(texto)) continue;

                        <li>
                            <span class="alt-letra">@letra)</span>
                            <span>@texto</span>
                        </li>
                    }
                </ul>
            </div>
        }

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/imprimir-prova.js" asp-append-version="true"></script>
</body>
</html>
