@model SistemaAvaliacao.Web.Models.ViewModels.DetalhesProvaViewModel
@{
    ViewData["Title"] = Model.Nome;
    var dataInicioLocal = Model.DataInicio.ParaFusoLocal();
    var dataFimLocal    = Model.DataFim.ParaFusoLocal();
}

<div class="container py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Provas">Provas</a></li>
            <li class="breadcrumb-item active">@Model.Nome</li>
        </ol>
    </nav>

    @* ── Cabeçalho ── *@
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-1">
        <div>
            <h3 class="fw-bold mb-1" id="tituloProva">@Model.Nome</h3>
            @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
            {
                <span class="badge bg-secondary me-1"><i class="fas fa-print me-1"></i>Prova Física</span>
            }
            else
            {
                <span class="badge bg-primary me-1"><i class="fas fa-globe me-1"></i>Prova Virtual</span>
            }
            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                <p class="text-muted mb-0 small mt-1" id="descricaoProva">@Model.Descricao</p>
            }
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (!Model.Bloqueada)
            {
                <button class="btn btn-outline-secondary btn-sm" id="btnAbrirEdicao">
                    <i class="fas fa-pen me-1"></i>Editar
                </button>
            }
        </div>
    </div>

    <p class="text-muted small mb-4">
        <i class="fas fa-calendar me-1"></i>@dataInicioLocal.ToString("dd/MM/yyyy HH:mm") — @dataFimLocal.ToString("dd/MM/yyyy HH:mm")
        <span class="mx-2">·</span>
        <i class="fas fa-user me-1"></i>@Model.NomeCriador
        <span id="metaInstituicao">
            @if (!string.IsNullOrWhiteSpace(Model.Instituicao))
            {
                <span class="mx-2">·</span>
                <i class="fas fa-building me-1"></i><span id="textoInstituicao">@Model.Instituicao</span>
            }
        </span>
    </p>

    @* ── Alerta bloqueada ── *@
    @if (Model.Bloqueada)
    {
        <div class="alert alert-info small py-2 mb-4">
            <i class="fas fa-lock me-1"></i>
            <strong>Prova em andamento:</strong> Um aluno já começou. As questões não podem mais ser alteradas.
        </div>
    }

    @* ── Cards de resumo ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-primary">@Model.NumeroQuestoes</div>
                    <small class="text-muted">Questões</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-secondary">@Model.NumeroAlunos</div>
                    <small class="text-muted">Alunos</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <span class="badge bg-@Model.StatusCss fs-6">@Model.Status</span>
                    <br /><small class="text-muted mt-1 d-inline-block">Status</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-success">@Model.AlunosFinalizados</div>
                    <small class="text-muted">Finalizados</small>
                </div>
            </div>
        </div>
    </div>

    @* ── Blocos de ação ── *@
    <div class="row g-3 mb-4 row-cols-2 row-cols-md-6">

        @* Alunos *@
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center action-block"
                 style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#modalAlunos">
                <div class="card-body py-4">
                    <i class="fas fa-users fa-2x text-secondary mb-3 d-block"></i>
                    <div class="fw-semibold">Alunos</div>
                    <small class="text-muted">
                        @if (Model.NumeroAlunos == 0) { <text>Clique para importar alunos</text> }
                        else { <text>Clique para gerenciar</text> }
                    </small>
                </div>
            </div>
        </div>

        @* Gerenciar Questões *@
        <div class="col">
            <a asp-controller="Questoes" asp-action="QuestoesProva" asp-route-id="@Model.Id"
               class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block @(Model.Bloqueada ? "opacity-50" : "")">
                <div class="card-body py-4">
                    <i class="fas fa-list-ol fa-2x text-primary mb-3 d-block"></i>
                    <div class="fw-semibold">Gerenciar Questões</div>
                    <small class="text-muted">
                        @if (Model.Bloqueada) { <text>Bloqueado</text> }
                        else { @($"{Model.NumeroQuestoes} questões") }
                    </small>
                </div>
            </a>
        </div>

        @* Folhas de Resposta — apenas para provas Físicas *@
        @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
        {
        <div class="col">
            @if (Model.NumeroAlunos > 0 && Model.NumeroQuestoes > 0)
            {
                <a asp-controller="Folhas" asp-action="GerarFolhasResposta" asp-route-id="@Model.Id"
                   class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block">
                    <div class="card-body py-4">
                        <i class="fas fa-qrcode fa-2x text-secondary mb-3 d-block"></i>
                        <div class="fw-semibold">Folhas de Resposta</div>
                        <small class="text-muted">Imprimir Folhas de Resposta</small>
                    </div>
                </a>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm text-center opacity-50">
                    <div class="card-body py-4">
                        <i class="fas fa-qrcode fa-2x text-muted mb-3 d-block"></i>
                        <div class="fw-semibold text-muted">Folhas de Resposta</div>
                        <small class="text-muted">Requer alunos e questões</small>
                    </div>
                </div>
            }
        </div>
        }

        @* Imprimir Prova — apenas para provas Físicas *@
        @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
        {
        <div class="col">
            @if (Model.NumeroQuestoes > 0)
            {
                <a asp-controller="Folhas" asp-action="ImprimirProva" asp-route-id="@Model.Id" target="_blank"
                   class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block">
                    <div class="card-body py-4">
                        <i class="fas fa-print fa-2x text-dark mb-3 d-block"></i>
                        <div class="fw-semibold">Imprimir Prova</div>
                        <small class="text-muted">
                            @if (Model.NumeroAlunos > 0)
                            { <text>@Model.NumeroAlunos @(Model.NumeroAlunos == 1 ? "cópia" : "cópias")</text> }
                            else
                            { <text>Abrir para imprimir</text> }
                        </small>
                    </div>
                </a>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm text-center opacity-50">
                    <div class="card-body py-4">
                        <i class="fas fa-print fa-2x text-muted mb-3 d-block"></i>
                        <div class="fw-semibold text-muted">Imprimir Prova</div>
                        <small class="text-muted">Requer questões</small>
                    </div>
                </div>
            }
        </div>
        }

        @* Correção OMR — apenas para provas Físicas *@
        @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
        {
        <div class="col">
            <a asp-controller="Correcao" asp-action="Enviar" asp-route-id="@Model.Id"
               class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block">
                <div class="card-body py-4">
                    <i class="fas fa-file-circle-check fa-2x text-info mb-3 d-block"></i>
                    <div class="fw-semibold">Correção</div>
                    <small class="text-muted">Enviar folhas digitalizadas</small>
                </div>
            </a>
        </div>
        }

        @* Copiar Link — apenas para provas Virtuais *@
        @if (Model.TipoAplicacao == TipoAplicacao.Virtual)
        {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center action-block"
                 style="cursor:pointer" onclick="copiarLink()">
                <div class="card-body py-4">
                    <i class="fas fa-link fa-2x text-secondary mb-3 d-block"></i>
                    <div class="fw-semibold">Copiar Link</div>
                    <small class="text-muted">Link público da prova</small>
                </div>
            </div>
        </div>
        }

        @* Exportar Resultados *@
        <div class="col">
            @if (Model.PodeExportar)
            {
                <div class="card h-100 border-0 shadow-sm text-center action-block" id="blocoExportar"
                     style="cursor:pointer" onclick="$('#modalExportar').modal('show')">
                    <div class="card-body py-4">
                        <i class="fas fa-file-export fa-2x text-success mb-3 d-block"></i>
                        <div class="fw-semibold">Exportar Resultados</div>
                        <small class="text-muted">CSV ou XLSX</small>
                    </div>
                </div>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm text-center opacity-50"
                     title="@(Model.AlunosFinalizados > 0 ? "Aguardando todos os alunos finalizarem ou prazo expirar" : "Disponível após a prova encerrar")">
                    <div class="card-body py-4">
                        <i class="fas fa-file-export fa-2x text-muted mb-3 d-block"></i>
                        <div class="fw-semibold text-muted">Exportar Resultados</div>
                        <small class="text-muted">
                            @if (Model.NumeroAlunos > 0 && Model.AlunosFinalizados > 0)
                            { <text>@Model.AlunosFinalizados / @Model.NumeroAlunos finalizados</text> }
                            else
                            { <text>Disponível após encerrar</text> }
                        </small>
                    </div>
                </div>
            }
        </div>

    </div>

</div>

@* ── Modais (partials) ── *@
<partial name="_ModalAlunos" model="Model" />
<partial name="_ModalErroImportacao" />
<partial name="_ModalExportar" model="Model" />
<partial name="_ModalRemoverAluno" model="Model" />
<partial name="_ModalEditarProva" model="Model" />

<input type="text" id="linkPublico" value="@Model.LinkPublico" style="position:absolute;left:-9999px" readonly />

@section Styles {
    <link rel="stylesheet" href="~/css/detalhes-prova.css" asp-append-version="true" />
}

@section Scripts {
    @* Dados do servidor para o JS externo (Razor codifica os valores com segurança). *@
    @Html.AntiForgeryToken()
    <div id="detalhesProvaConfig"
         data-prova-id="@Model.Id"
         data-url-importar-alunos="@Url.Action("ImportarAlunosProva", "Alunos")"
         data-url-editar="@Url.Action("EditarProvaModal", "Provas")"
         data-sucesso="@(TempData["Sucesso"])"
         data-erro="@(TempData["Erro"])"
         hidden></div>
    <script src="~/js/detalhes-prova.js" asp-append-version="true"></script>
}
