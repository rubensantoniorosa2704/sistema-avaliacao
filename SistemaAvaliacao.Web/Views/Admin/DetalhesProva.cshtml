@model SistemaAvaliacao.Web.Models.ViewModels.DetalhesProvaViewModel
@{
    ViewData["Title"] = Model.Nome;
    var dataInicioLocal = Model.DataInicio.ParaFusoLocal();
    var dataFimLocal    = Model.DataFim.ParaFusoLocal();
}

<div class="container py-4">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Provas">Provas</a></li>
            <li class="breadcrumb-item active">@Model.Nome</li>
        </ol>
    </nav>

    @* ── Cabeçalho ── *@
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-1">
        <div>
            <h3 class="fw-bold mb-1" id="tituloProva">@Model.Nome</h3>
            @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
            {
                <span class="badge bg-secondary me-1"><i class="fas fa-print me-1"></i>Prova Física</span>
            }
            else
            {
                <span class="badge bg-primary me-1"><i class="fas fa-globe me-1"></i>Prova Virtual</span>
            }
            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                <p class="text-muted mb-0 small mt-1" id="descricaoProva">@Model.Descricao</p>
            }
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (!Model.Bloqueada)
            {
                <button class="btn btn-outline-secondary btn-sm" id="btnAbrirEdicao">
                    <i class="fas fa-pen me-1"></i>Editar
                </button>
            }
        </div>
    </div>

    <p class="text-muted small mb-4">
        <i class="fas fa-calendar me-1"></i>@dataInicioLocal.ToString("dd/MM/yyyy HH:mm") — @dataFimLocal.ToString("dd/MM/yyyy HH:mm")
        <span class="mx-2">·</span>
        <i class="fas fa-user me-1"></i>@Model.NomeCriador
    </p>

    @* ── Alerta bloqueada ── *@
    @if (Model.Bloqueada)
    {
        <div class="alert alert-info small py-2 mb-4">
            <i class="fas fa-lock me-1"></i>
            <strong>Prova em andamento:</strong> Um aluno já começou. As questões não podem mais ser alteradas.
        </div>
    }

    @* ── Cards de resumo ── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-primary">@Model.NumeroQuestoes</div>
                    <small class="text-muted">Questões</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-secondary">@Model.NumeroAlunos</div>
                    <small class="text-muted">Alunos</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <span class="badge bg-@Model.StatusCss fs-6">@Model.Status</span>
                    <br /><small class="text-muted mt-1 d-inline-block">Status</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body py-3">
                    <div class="fs-3 fw-bold text-success">@Model.AlunosFinalizados</div>
                    <small class="text-muted">Finalizados</small>
                </div>
            </div>
        </div>
    </div>

    @* ── Blocos de ação ── *@
    <div class="row g-3 mb-4 row-cols-2 row-cols-md-6">

        @* Alunos *@
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center action-block"
                 style="cursor:pointer" data-bs-toggle="modal" data-bs-target="#modalAlunos">
                <div class="card-body py-4">
                    <i class="fas fa-users fa-2x text-secondary mb-3 d-block"></i>
                    <div class="fw-semibold">Alunos</div>
                    <small class="text-muted">
                        @if (Model.NumeroAlunos == 0) { <text>Clique para importar alunos</text> }
                        else { <text>Clique para gerenciar</text> }
                    </small>
                </div>
            </div>
        </div>

        @* Gerenciar Questões *@
        <div class="col">
            <a asp-action="QuestoesProva" asp-route-id="@Model.Id"
               class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block @(Model.Bloqueada ? "opacity-50" : "")">
                <div class="card-body py-4">
                    <i class="fas fa-list-ol fa-2x text-primary mb-3 d-block"></i>
                    <div class="fw-semibold">Gerenciar Questões</div>
                    <small class="text-muted">
                        @if (Model.Bloqueada) { <text>Bloqueado</text> }
                        else { @($"{Model.NumeroQuestoes} questões") }
                    </small>
                </div>
            </a>
        </div>

        @* Folhas de Resposta — apenas para provas Físicas *@
        @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
        {
        <div class="col">
            @if (Model.NumeroAlunos > 0 && Model.NumeroQuestoes > 0)
            {
                <a asp-action="GerarFolhasResposta" asp-route-id="@Model.Id"
                   class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block">
                    <div class="card-body py-4">
                        <i class="fas fa-qrcode fa-2x text-secondary mb-3 d-block"></i>
                        <div class="fw-semibold">Folhas de Resposta</div>
                        <small class="text-muted">Imprimir Folhas de Resposta</small>
                    </div>
                </a>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm text-center opacity-50">
                    <div class="card-body py-4">
                        <i class="fas fa-qrcode fa-2x text-muted mb-3 d-block"></i>
                        <div class="fw-semibold text-muted">Folhas de Resposta</div>
                        <small class="text-muted">Requer alunos e questões</small>
                    </div>
                </div>
            }
        </div>
        }

        @* Imprimir Prova — apenas para provas Físicas *@
        @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
        {
        <div class="col">
            @if (Model.NumeroQuestoes > 0)
            {
                <a asp-action="ImprimirProva" asp-route-id="@Model.Id" target="_blank"
                   class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block">
                    <div class="card-body py-4">
                        <i class="fas fa-print fa-2x text-dark mb-3 d-block"></i>
                        <div class="fw-semibold">Imprimir Prova</div>
                        <small class="text-muted">
                            @if (Model.NumeroAlunos > 0)
                            { <text>@Model.NumeroAlunos @(Model.NumeroAlunos == 1 ? "cópia" : "cópias")</text> }
                            else
                            { <text>Abrir para imprimir</text> }
                        </small>
                    </div>
                </a>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm text-center opacity-50">
                    <div class="card-body py-4">
                        <i class="fas fa-print fa-2x text-muted mb-3 d-block"></i>
                        <div class="fw-semibold text-muted">Imprimir Prova</div>
                        <small class="text-muted">Requer questões</small>
                    </div>
                </div>
            }
        </div>
        }

        @* Correção OMR — apenas para provas Físicas *@
        @if (Model.TipoAplicacao == TipoAplicacao.Fisica)
        {
        <div class="col">
            <a asp-controller="Correcao" asp-action="Enviar" asp-route-id="@Model.Id"
               class="card h-100 border-0 shadow-sm text-center text-decoration-none action-block">
                <div class="card-body py-4">
                    <i class="fas fa-file-circle-check fa-2x text-info mb-3 d-block"></i>
                    <div class="fw-semibold">Correção</div>
                    <small class="text-muted">Enviar folhas digitalizadas</small>
                </div>
            </a>
        </div>
        }

        @* Copiar Link — apenas para provas Virtuais *@
        @if (Model.TipoAplicacao == TipoAplicacao.Virtual)
        {
        <div class="col">
            <div class="card h-100 border-0 shadow-sm text-center action-block"
                 style="cursor:pointer" onclick="copiarLink()">
                <div class="card-body py-4">
                    <i class="fas fa-link fa-2x text-secondary mb-3 d-block"></i>
                    <div class="fw-semibold">Copiar Link</div>
                    <small class="text-muted">Link público da prova</small>
                </div>
            </div>
        </div>
        }

        @* Exportar Resultados *@
        <div class="col">
            @if (Model.PodeExportar)
            {
                <div class="card h-100 border-0 shadow-sm text-center action-block" id="blocoExportar"
                     style="cursor:pointer" onclick="$('#modalExportar').modal('show')">
                    <div class="card-body py-4">
                        <i class="fas fa-file-export fa-2x text-success mb-3 d-block"></i>
                        <div class="fw-semibold">Exportar Resultados</div>
                        <small class="text-muted">CSV ou XLSX</small>
                    </div>
                </div>
            }
            else
            {
                <div class="card h-100 border-0 shadow-sm text-center opacity-50"
                     title="@(Model.AlunosFinalizados > 0 ? "Aguardando todos os alunos finalizarem ou prazo expirar" : "Disponível após a prova encerrar")">
                    <div class="card-body py-4">
                        <i class="fas fa-file-export fa-2x text-muted mb-3 d-block"></i>
                        <div class="fw-semibold text-muted">Exportar Resultados</div>
                        <small class="text-muted">
                            @if (Model.NumeroAlunos > 0 && Model.AlunosFinalizados > 0)
                            { <text>@Model.AlunosFinalizados / @Model.NumeroAlunos finalizados</text> }
                            else
                            { <text>Disponível após encerrar</text> }
                        </small>
                    </div>
                </div>
            }
        </div>

    </div>

</div>

@* ── Modal alunos ── *@
<div class="modal fade" id="modalAlunos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-users me-2 text-secondary"></i>Alunos
                    @if (Model.NumeroAlunos > 0)
                    {
                        <span class="badge bg-secondary ms-1">@Model.NumeroAlunos</span>
                    }
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                @* Grid de alunos *@
                @if (Model.Alunos.Any())
                {
                    <div class="table-responsive mb-3" style="max-height:320px;overflow-y:auto">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Nome</th>
                                    <th>E-mail</th>
                                    <th class="text-center">Status</th>
                                    <th style="width:40px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Alunos)
                                {
                                    var statusBadge = a.Status switch { "Finalizada" => "success", "EmAndamento" => "warning", _ => "secondary" };
                                    var statusLabel = a.Status switch { "NaoIniciada" => "Pendente", "EmAndamento" => "Em andamento", "Finalizada" => "Finalizada", _ => a.Status };
                                    var emailParts = a.EmailAluno.Split('@');
                                    var emailMask = emailParts.Length == 2
                                        ? (emailParts[0].Length > 2 ? emailParts[0][..2] + "**" : emailParts[0]) + "@" + emailParts[1]
                                        : a.EmailAluno;
                                    <tr>
                                        <td class="fw-medium">@a.NomeAluno</td>
                                        <td class="text-muted small">@emailMask</td>
                                        <td class="text-center"><span class="badge bg-@statusBadge">@statusLabel</span></td>
                                        <td>
                                            @* Só pode remover quem ainda não iniciou *@
                                            @if (a.Status == "NaoIniciada")
                                            {
                                                <button type="button" class="btn btn-sm btn-light text-danger btn-remover-aluno"
                                                        data-id="@a.AlunoId" data-nome="@a.NomeAluno" title="Remover">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3 mb-3">
                        <i class="fas fa-users fa-2x text-muted mb-2 d-block" style="opacity:.4"></i>
                        <p class="text-muted mb-0 small">Nenhum aluno importado ainda.</p>
                    </div>
                }

                @* Import CSV *@
                @if (!Model.Bloqueada)
                {
                    <hr class="my-3" />
                    <div class="row g-3 row-cols-2">
                        <div class="col">
                            <div class="card border-0 shadow-sm text-center action-block"
                                 style="cursor:pointer" onclick="document.getElementById('inputCsvAlunos').click()">
                                <div class="card-body py-4">
                                    <i class="fas fa-file-csv fa-2x text-primary mb-2 d-block"></i>
                                    <div class="fw-semibold small">Importar CSV</div>
                                </div>
                            </div>
                            <input type="file" id="inputCsvAlunos" accept=".csv" style="display:none" />
                        </div>
                        <div class="col">
                            <a asp-action="BaixarModeloCsv"
                               class="card border-0 shadow-sm text-center text-decoration-none action-block h-100">
                                <div class="card-body py-4">
                                    <i class="fas fa-download fa-2x text-secondary mb-2 d-block"></i>
                                    <div class="fw-semibold small">Baixar Modelo</div>
                                </div>
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@* ── Modal erro importação ── *@
<div class="modal fade" id="modalErroImportacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <i class="fas fa-circle-exclamation text-danger fa-2x mb-3 d-block"></i>
                <h6>Erro na importação</h6>
                <p class="text-muted small mb-3" id="erroImportacaoMsg">Confira o arquivo e tente novamente.</p>
                <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">Entendi</button>
            </div>
        </div>
    </div>
</div>

@* ── Modal exportar ── *@
<div class="modal fade" id="modalExportar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-semibold">Exportar Resultados</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-grid gap-2">
                <a asp-action="ExportarResultadosCsv" asp-route-id="@Model.Id" class="btn btn-success">
                    <i class="fas fa-file-csv me-2"></i>Resultados CSV
                    <small class="d-block text-white-50">Acertos, erros e pendências por aluno</small>
                </a>
                <a asp-action="ExportarMatrizRespostas" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-file-csv me-2"></i>Matriz CSV
                    <small class="d-block text-muted">Respostas 0/1 para análise psicométrica</small>
                </a>
                <a asp-action="ExportarResultadosXlsx" asp-route-id="@Model.Id" class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-2"></i>Relatório XLSX
                    <small class="d-block text-muted">Respostas, acertos e score por aluno</small>
                </a>
            </div>
        </div>
    </div>
</div>

@* ── Modal remover aluno ── *@
<div class="modal fade" id="modalRemoverAluno" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <i class="fas fa-user-times text-danger fa-2x mb-3"></i>
                <h6>Remover aluno?</h6>
                <p class="text-muted small mb-3" id="modalNomeAluno"></p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="RemoverAlunoProva" method="post">
                        <input type="hidden" name="provaId" value="@Model.Id" />
                        <input type="hidden" name="alunoId" id="removerAlunoId" />
                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-times me-1"></i>Remover</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Modal editar prova ── *@
<div class="modal fade" id="modalEditarProva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Prova</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="editarErro" class="alert alert-danger d-none small py-2"></div>
                <div class="mb-3">
                    <label class="form-label">Nome <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="editNome" maxlength="300" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <textarea class="form-control" id="editDescricao" rows="2" maxlength="1000"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Alternativas por questão</label>
                    <select class="form-select" id="editAlternativas">
                        <option value="4">4 alternativas (A–D)</option>
                        <option value="5">5 alternativas (A–E)</option>
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Início <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" id="editDataInicio" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fim <span class="text-danger">*</span></label>
                        <input type="datetime-local" class="form-control" id="editDataFim" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnSalvarEdicao">
                    <i class="fas fa-check me-1"></i>Salvar
                </button>
            </div>
        </div>
    </div>
</div>

<input type="text" id="linkPublico" value="@Model.LinkPublico" style="position:absolute;left:-9999px" readonly />

@section Scripts {
<script>
    const provaId = '@Model.Id';
    const antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] ?? '';

    function copiarLink() {
        navigator.clipboard.writeText(document.getElementById('linkPublico').value)
            .then(() => toastr.success('Link copiado!'));
    }

    $(function () {
        // Upload automático ao selecionar CSV
        document.getElementById('inputCsvAlunos')?.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('provaId', provaId);
            formData.append('arquivoCsv', file);
            formData.append('__RequestVerificationToken', antiForgery);

            // Fecha o modal de alunos
            bootstrap.Modal.getInstance('#modalAlunos')?.hide();

            fetch('@Url.Action("ImportarAlunosProva", "Admin")', {
                method: 'POST',
                body: formData
            })
            .then(r => {
                if (r.redirected || r.ok) {
                    // Sucesso — recarrega para refletir os novos alunos
                    window.location.reload();
                } else {
                    return r.text().then(msg => { throw new Error(msg || 'Erro desconhecido.'); });
                }
            })
            .catch(err => {
                document.getElementById('erroImportacaoMsg').textContent =
                    'Confira o arquivo CSV e tente novamente.';
                new bootstrap.Modal('#modalErroImportacao').show();
            });

            // Limpa o input para permitir re-seleção do mesmo arquivo
            this.value = '';
        });

        $(document).on('click', '.btn-remover-aluno', function () {
            $('#removerAlunoId').val($(this).data('id'));
            $('#modalNomeAluno').text($(this).data('nome'));
            new bootstrap.Modal('#modalRemoverAluno').show();
        });

        $('#btnAbrirEdicao').on('click', function () {
            $('#editNome').val('@Html.Raw(Model.Nome.Replace("'", "\\'"))');
            $('#editDescricao').val('@Html.Raw((Model.Descricao ?? "").Replace("'", "\\'"))');
            $('#editAlternativas').val('@Model.NumeroAlternativas');
            $('#editDataInicio').val('@dataInicioLocal.ToString("yyyy-MM-ddTHH:mm")');
            $('#editDataFim').val('@dataFimLocal.ToString("yyyy-MM-ddTHH:mm")');
            $('#editarErro').addClass('d-none').text('');
            new bootstrap.Modal('#modalEditarProva').show();
        });

        $('#btnSalvarEdicao').on('click', function () {
            const nome = $('#editNome').val().trim();
            if (!nome) { $('#editarErro').removeClass('d-none').text('Nome é obrigatório.'); return; }

            const body = new URLSearchParams({
                Id: provaId,
                Nome: nome,
                Descricao: $('#editDescricao').val(),
                NumeroAlternativas: $('#editAlternativas').val(),
                DataInicio: $('#editDataInicio').val(),
                DataFim: $('#editDataFim').val(),
                __RequestVerificationToken: antiForgery
            });

            $('#btnSalvarEdicao').prop('disabled', true);
            fetch('@Url.Action("EditarProvaModal", "Admin")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            })
            .then(async r => {
                if (!r.ok) {
                    const erros = await r.json();
                    $('#editarErro').removeClass('d-none').text(Array.isArray(erros) ? erros.join(' ') : 'Erro ao salvar.');
                    return;
                }
                const data = await r.json();
                $('#tituloProva').text(data.nome);
                $('#descricaoProva').text(data.descricao ?? '');
                document.title = data.nome;
                bootstrap.Modal.getInstance('#modalEditarProva').hide();
                toastr.success('Prova atualizada!');
            })
            .finally(() => $('#btnSalvarEdicao').prop('disabled', false));
        });

        @if (TempData["Sucesso"] != null)
        {
            <text>toastr.success('@Html.Raw(TempData["Sucesso"])');</text>
        }
        @if (TempData["Erro"] != null)
        {
            <text>toastr.error('@Html.Raw(TempData["Erro"])', '', { timeOut: 10000 });</text>
        }
    });
</script>
<style>
    .action-block { transition: box-shadow .15s, transform .15s; }
    .action-block:hover { box-shadow: 0 4px 16px rgba(0,0,0,.12) !important; transform: translateY(-2px); }
</style>
}
