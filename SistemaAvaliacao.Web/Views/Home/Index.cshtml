@{
    if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        // Redirecionar pra Admin/Provas via JS (no servidor Response.Redirect seria melhor, mas aqui é view)
        <script>
            window.location.href = '@Url.Action("Provas", "Admin")';
        </script>
    }
    ViewData["Title"] = "Home";
}

<div class="row">
    <div class="col-md-3">
        <div class="text-center">
            <div class="big-icon mb-3">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <h4>Sistema de Avaliação</h4>
            <p class="text-muted">Sistema de aplicação de provas online</p>
        </div>
    </div>
</div>
