@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

@await Html.PartialAsync("_PaginaEstado", new PaginaEstadoViewModel
{
    Variante = "danger",
    Icone = "fa-triangle-exclamation",
    Titulo = "Ocorreu um erro",
    Mensagem = "Não foi possível concluir sua solicitação. Tente novamente em instantes.",
    Destaque = Model.ShowRequestId
        ? new DestaqueEstado
        {
            Variante = "secondary",
            Rotulo = "Código do erro (informe ao suporte):",
            Texto = Model.RequestId!
        }
        : null,
    BotaoTexto = "Voltar ao início",
    BotaoUrl = Url.Action("Index", "Home")
})
