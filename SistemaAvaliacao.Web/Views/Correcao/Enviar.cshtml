@model SistemaAvaliacao.Web.Models.ViewModels.EnviarCorrecaoViewModel
@{
    ViewData["Title"] = "Enviar correção";
}

<div class="container py-4" style="max-width:720px">
    <a asp-action="Index" class="small text-muted"><i class="fas fa-arrow-left me-1"></i>Voltar</a>
    <div class="mt-3 mb-4">
        <h3 class="fw-bold mb-1">Enviar correção</h3>
        <p class="text-muted mb-0">@Model.NomeProva</p>
    </div>

    @if (TempData["Erro"] is string erro)
    {
        <div class="alert alert-danger">
            <i class="fas fa-circle-exclamation me-2"></i>@erro
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <div class="alert alert-info small">
                <i class="fas fa-circle-info me-2"></i>
                Envie o PDF único contendo as folhas digitalizadas. O processamento será feito em segundo plano.
            </div>

            <form asp-action="Enviar" method="post" enctype="multipart/form-data">
                <input asp-for="ProvaId" type="hidden" />
                <input asp-for="NomeProva" type="hidden" />
                <div class="mb-3">
                    <label asp-for="ArquivoPdf" class="form-label">PDF das folhas de respostas</label>
                    <input asp-for="ArquivoPdf" class="form-control" accept="application/pdf,.pdf" />
                    <span asp-validation-for="ArquivoPdf" class="text-danger small"></span>
                    <div class="form-text">Máximo de 100 MB.</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload me-2"></i>Enviar PDF
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
